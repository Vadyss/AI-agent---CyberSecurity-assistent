# Copy to .env (git-ignored) and fill in. `sh scripts/bootstrap-env.sh` creates .env
# and generates the two random secrets below. An empty value means "use the default".
# The demo (docker-compose.demo.yml) needs only POSTGRES_PASSWORD; it uses the mock model.
# Never commit .env or put real values in this file.

# --- Required secrets -------------------------------------------------------------
# Password of the bundled PostgreSQL (generated by bootstrap-env.sh).
POSTGRES_PASSWORD=
# 32-character cookie key for oauth2-proxy (generated by bootstrap-env.sh).
OAUTH2_PROXY_COOKIE_SECRET=

# --- Language model (see Docs/LLM_PROVIDERS.md) -----------------------------------
# apify | openai_compatible | mock. Production refuses mock.
LLM_PROVIDER=
# API key for openai_compatible providers (and an alternative to APIFY_TOKEN for apify).
LLM_API_KEY=
# Apify API token, used when LLM_PROVIDER=apify.
APIFY_TOKEN=
# API prefix of the provider, e.g. https://openrouter.ai/api/v1 (no /chat/completions).
# Required for every provider except mock; there is no default.
LLM_BASE_URL=
# Model for all roles; the per-role variables below override it.
LLM_MODEL=
LLM_MODEL_PLANNER=
LLM_MODEL_FORGE=
LLM_MODEL_RULE=
LLM_MODEL_SUMMARY=
# Used after repeated failures of the primary model.
LLM_MODEL_FALLBACK=
# Model of the optional examiner (EXAMINER_ENABLED).
LLM_MODEL_EXAMINER=
# minimal | low | medium | high | xhigh | max. Compose defaults to low.
LLM_REASONING_EFFORT=
# Seconds per request (default 180).
LLM_TIMEOUT_S=
# Output tokens per call (default 16000) and the ceiling for length retries (default 32000).
LLM_MAX_TOKENS=
LLM_MAX_TOKENS_CAP=
# Retries per call, 0 to 2 (default 2).
LLM_MAX_RETRIES=
# Hard cap of model calls per run, 1 to 25 (default 25).
LLM_MAX_CALLS_PER_RUN=
# Mock model only: force scenario A to F (empty: chosen from the request text) and its delay.
MOCK_SCENARIO=
MOCK_DELAY_MS=
# Let an independent examiner generate test data for attack types without a dataset (true/false).
EXAMINER_ENABLED=

# --- Optional voice summary (ElevenLabs); leave empty to disable ------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Sign-in (production and the dev stack; ignored by the demo) ------------------
# production | development. Only development may run with AUTH_MODE=disabled.
ENVIRONMENT=
# oidc | disabled
AUTH_MODE=
# Public HTTPS URL of the installation, no trailing slash. Used as redirect URL and CORS origin.
PUBLIC_URL=
# Your OIDC provider: issuer URL, client ID, the JWKS URL and the client secret.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_SECRET=
# Accepted asymmetric JWT algorithms (default RS256,ES256).
OIDC_ALGORITHMS=
# E-mail of the first administrator (must be verified at the provider) and the name of the first tenant.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_TENANT_NAME=
# invite_only (default) | self_service
SIGNUP_MODE=
# Host interface for the published oauth2-proxy port 4180 (default 127.0.0.1).
PUBLIC_BIND=

# --- Limits and quotas (defaults in parentheses) ----------------------------------
# Requests per minute per user or API key (300) and new runs per minute per tenant (10).
RATE_LIMIT_PER_MINUTE=
RUN_RATE_LIMIT_PER_MINUTE=
# Model budget per tenant per month in USD (50) and runs per tenant per day (200).
DEFAULT_MONTHLY_BUDGET_USD=
DEFAULT_MAX_RUNS_PER_DAY=
# Pipelines running at once (2), queued runs per tenant (10), attempts per run (2).
WORKER_CONCURRENCY=
MAX_QUEUED_RUNS_PER_TENANT=
RUN_MAX_ATTEMPTS=
# Seconds before a run is aborted (1500); days to keep finished runs (365, 0 keeps them).
RUN_TIMEOUT_S=
RUN_RETENTION_DAYS=
# Concurrent sandbox jobs overall (2) and per tenant (1); seconds per sandbox job (30).
SANDBOX_MAX_JOBS=
SANDBOX_MAX_JOBS_PER_TENANT=
SANDBOX_TIMEOUT_S=

# --- Deployment paths and networking ----------------------------------------------
# Browser origins allowed for CORS and WebSocket handshakes (default: PUBLIC_URL).
CORS_ORIGINS=
# Backend origin as the browser sees it; baked into the frontend at build time.
NEXT_PUBLIC_API_BASE=
# Host interface for the demo backend port 8000 (default 127.0.0.1).
BACKEND_BIND_HOST=
# Sandbox URL, data directory, datasets, policy file and seed tools. The image sets these.
SANDBOX_URL=
DATA_DIR=
DATASETS_DIR=
POLICY_PATH=
SEED_SKILLS_DIR=

# --- Observability ----------------------------------------------------------------
LOG_LEVEL=
# json (default) | text
LOG_FORMAT=
# Prometheus metrics port inside the Docker network (9100, 0 disables).
METRICS_PORT=
# OTLP/HTTP endpoint for traces; empty disables tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Version string reported by the API; set to the git commit when building.
APP_VERSION=
